<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".NeovimEditorActivity"
            android:exported="true"
            android:icon="@mipmap/ic_neovim"
            android:roundIcon="@mipmap/ic_neovim"
            android:label="Neovim"
            android:launchMode="singleTask"
            android:taskAffinity=".NeovimEditorActivity"
            android:excludeFromRecents="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout"
            android:theme="@style/NeovimTheme"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.aarchdroid.neovim.OPEN_EDITOR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
