<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    android:background="#000000"
    app:cardBackgroundColor="#111111"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeColor="#2fff00"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_gps_provider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPS Provider"
            android:textColor="#e0e0e0"
            android:textOff="OFF"
            android:textOn="ON"
            android:paddingBottom="8dp"
            app:thumbTint="#2fff00"
            app:trackTint="#333333" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_gpsd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPSD Service"
            android:textColor="#e0e0e0"
            android:paddingBottom="16dp"
            app:thumbTint="#2fff00"
            app:trackTint="#333333" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="WLAN Interface (e.g. wlan0)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#2fff00"
            app:boxBackgroundColor="@android:color/transparent"
            app:hintTextColor="#8FBC8F"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/wlan_interface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="none"
                android:ems="10"
                android:textColor="#e0e0e0"
                android:textColorHint="#666666"
                android:inputType="text"
                android:text="wlan0" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bluetooth Device (e.g. hci0)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#2fff00"
            app:boxBackgroundColor="@android:color/transparent"
            app:hintTextColor="#8FBC8F"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/bt_interface"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#e0e0e0"
                android:textColorHint="#666666"
                android:inputType="text"
                android:text="hci0" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Current Satellites"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#2fff00"
            app:boxBackgroundColor="@android:color/transparent"
            app:hintTextColor="#8FBC8F">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/gps_current_satellites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#2fff00"
                android:cursorVisible="false"
                android:text="No satellites"
                android:focusable="false"
                android:inputType="textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <ProgressBar
            android:id="@+id/gps_signal_strength"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:progressTint="#2fff00"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/gps_scroll"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:fillViewport="true"
            android:background="#000000"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/gps_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="160dp"
                android:fontFamily="monospace"
                android:padding="8dp"
                android:textColor="#2fff00"
                android:textSize="11sp"
                android:scrollbars="vertical"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="bottom"
                android:text="GPS output will appear here..." />
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gps_button_launch_app"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Launch GPS App"
                android:textColor="#000000"
                android:backgroundTint="#2fff00"
                android:layout_margin="4dp"
                style="@style/Widget.MaterialComponents.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/gps_button_settings"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#1a1a1a"
                android:textColor="#2fff00"
                android:text="Settings"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/gps_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="Enable GPS Provider to start wardriving. GPSD provides GPS data to Kali chroot."
            android:textColor="#8FBC8F"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
