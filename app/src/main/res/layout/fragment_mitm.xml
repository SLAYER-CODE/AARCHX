<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eviltwin_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Card 1: Target Configuration -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_dark"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"
                    android:text="TARGET CONFIGURATION"
                    android:textColor="#2fff00"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Monitor Interface"
                    android:textColor="#2fff00"
                    android:textSize="12sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_inner"
                    android:padding="4dp">

                    <Spinner
                        android:id="@+id/eviltwin_interface"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:spinnerMode="dropdown"
                        android:textColor="#e0e0e0" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:text="Target Network"
                    android:textColor="#2fff00"
                    android:textSize="12sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_inner"
                    android:padding="4dp">

                    <Spinner
                        android:id="@+id/eviltwin_target"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:spinnerMode="dropdown"
                        android:textColor="#e0e0e0" />
                </FrameLayout>

                <TextView
                    android:id="@+id/eviltwin_channel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Channel: --"
                    android:textColor="#2fff00"
                    android:textSize="14sp" />

            </LinearLayout>
        </FrameLayout>

        <!-- Card 2: Scan Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_dark"
            android:padding="12dp">

            <Button
                android:id="@+id/eviltwin_scan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="SCAN NETWORKS"
                android:textColor="#2fff00" />
        </FrameLayout>

        <!-- Card 3: AP Configuration -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_dark"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"
                    android:text="FAKE ACCESS POINT"
                    android:textColor="#2fff00"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/eviltwin_ap_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/eviltwin_ap_virtual"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Virtual AP from wlan0"
                        android:textColor="#e0e0e0" />

                    <RadioButton
                        android:id="@+id/eviltwin_ap_existing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Use External Adapter"
                        android:textColor="#e0e0e0" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="AP Interface Name"
                    android:textColor="#2fff00"
                    android:textSize="12sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_inner"
                    android:padding="4dp">

                    <EditText
                        android:id="@+id/eviltwin_ap_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:hint="AP Interface Name"
                        android:padding="8dp"
                        android:text="wlan3"
                        android:textColor="#e0e0e0"
                        android:textColorHint="#666666" />
                </FrameLayout>

            </LinearLayout>
        </FrameLayout>

        <!-- Card 4: Internet Source -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_dark"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"
                    android:text="INTERNET SOURCE"
                    android:textColor="#2fff00"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/eviltwin_internet_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/eviltwin_internet_auto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Auto-detect (recommended)"
                        android:textColor="#e0e0e0" />

                    <RadioButton
                        android:id="@+id/eviltwin_internet_wifi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="WiFi (wlan0)"
                        android:textColor="#e0e0e0" />
                </RadioGroup>

            </LinearLayout>
        </FrameLayout>

        <!-- Card 5: Controls -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_dark"
            android:padding="12dp">

            <Button
                android:id="@+id/eviltwin_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#2fff00"
                android:text="START"
                android:textColor="#000000" />
        </FrameLayout>

        <!-- Card 6: Output Logs -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_dark"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OUTPUT"
                        android:textColor="#2fff00"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Made by @dr.rootsu"
                        android:textColor="#8FBC8F"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/eviltwin_clear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:text="CLEAR"
                        android:textColor="#2fff00" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_log"
                    android:padding="4dp">

                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/eviltwin_log"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:scrollbars="vertical"
                            android:text="Ready. Select options and click START."
                            android:textColor="#2fff00"
                            android:textSize="11sp" />
                    </androidx.core.widget.NestedScrollView>
                </FrameLayout>

            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</ScrollView>
