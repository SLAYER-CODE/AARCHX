<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ─── USB INTERFACE SWITCH ─── -->

        <LinearLayout
            android:id="@+id/f_usbarsenal_ll_usbswitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/f_usbarsenal_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="4dp"
                android:text="Configure USB gadget functions (HID, RNDIS, CDC ACM, Mass Storage) via configfs."
                android:textColor="#8FBC8F"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1a1a1a"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="USB SWITCH"
                    android:textColor="#2fff00"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:orientation="vertical">

                <!-- Target + Spinner -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/f_usbarsenal_tv_target"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Target"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_spr_targetplatform"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.4" />

                    <Spinner
                        android:id="@+id/f_usbarsenal_spr_targetplatform"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:entries="@array/usbarsenal_target_platform"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_tv_target"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- USB Function + Spinner -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/f_usbarsenal_tv_usbfunc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="USB Function"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_spr_usbfunctions"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.4" />

                    <Spinner
                        android:id="@+id/f_usbarsenal_spr_usbfunctions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:entries="@array/usbarsenal_usb_states_win_lin"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_tv_usbfunc"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- ADB + Spinner -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/f_usbarsenal_tv_adb"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="ADB"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_spr_adb"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.4" />

                    <Spinner
                        android:id="@+id/f_usbarsenal_spr_adb"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:entries="@array/usbarsenal_usb_adb"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_tv_adb"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- idVendor + EditText -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/f_usbarsenal_tv_idvendor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="idVendor"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_et_idvendor"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.4" />

                    <EditText
                        android:id="@+id/f_usbarsenal_et_idvendor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_tv_idvendor"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- idProduct + EditText -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/f_usbarsenal_tv_idproduct"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="idProduct"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_et_idproduct"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.4" />

                    <EditText
                        android:id="@+id/f_usbarsenal_et_idproduct"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_tv_idproduct"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- manufacturer + EditText -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/f_usbarsenal_tv_manufacturer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="manufacturer"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_et_manufacturer"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.4" />

                    <EditText
                        android:id="@+id/f_usbarsenal_et_manufacturer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_tv_manufacturer"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- product + EditText -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/f_usbarsenal_tv_product"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="product"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_et_product"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.4" />

                    <EditText
                        android:id="@+id/f_usbarsenal_et_product"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_tv_product"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- serialnumber + EditText -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/f_usbarsenal_tv_serialnumber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="serialnumber"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_et_serialnumber"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.4" />

                    <EditText
                        android:id="@+id/f_usbarsenal_et_serialnumber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_tv_serialnumber"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <Button
                    android:id="@+id/f_usbarsenal_btn_setusbinterface"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#2fff00"
                    android:text="SET USB FUNCTION"
                    android:textColor="#000000"
                    style="?android:attr/buttonStyleSmall" />

                <Button
                    android:id="@+id/f_usbarsenal_btn_saveusbfuncswitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="#1a1a1a"
                    android:text="SAVE CONFIG TO DATABASE"
                    android:textColor="#2fff00" />

                <!-- Enabled Functions row -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:id="@+id/f_usbarsenal_ll_enabled_funcs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_imgbtn_reloadUSBStatus">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Enabled Functions:"
                            android:textColor="#2fff00"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/f_usbarsenal_tv_current_usb_state"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#e0e0e0"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/f_usbarsenal_imgbtn_reloadUSBStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="false"
                        android:backgroundTint="#2fff00"
                        android:baselineAlignBottom="false"
                        android:contentDescription="Reload"
                        android:cropToPadding="false"
                        android:src="@android:drawable/ic_menu_rotate"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_ll_enabled_funcs"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.15" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- ─── IMAGE MOUNTER ─── -->

        <LinearLayout
            android:id="@+id/f_usbarsenal_ll_imageMounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/f_usbarsenal_ll_imageMounter_sub1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#1a1a1a"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="IMAGE MOUNTER"
                    android:textColor="#2fff00"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/f_usbarsenal_ll_tv_imagemounter_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:text="Mount .img/.iso files as USB mass storage."
                android:textColor="#8FBC8F"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/f_usbarsenal_ll_imageMounter_sub2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Step 1: Place .img files in /sdcard/nh_files/" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Select image to mount:"
                    android:textColor="#2fff00"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/f_usbarsenal_spr_img_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/f_usbarsenal_btn_mountImage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3"
                        android:backgroundTint="#2fff00"
                        android:text="Mount"
                        android:textColor="#000000"
                        style="?android:attr/buttonStyleSmall" />

                    <Button
                        android:id="@+id/f_usbarsenal_btn_unmountImage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3"
                        android:backgroundTint="#1a1a1a"
                        android:text="Unmount"
                        android:textColor="#2fff00"
                        style="?android:attr/buttonStyleSmall" />

                    <CheckBox
                        android:id="@+id/f_usbarsenal_chkbox_ReadOrWrite"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.4"
                        android:paddingBottom="5dp"
                        android:paddingTop="5dp"
                        android:text="Read Only"
                        android:textColor="#e0e0e0" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="14dp" />

                <!-- Mounted Image row -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/f_usbarsenal_ll_mounted_state"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_imgbtn_reloadMountStatus"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mounted Image:"
                            android:textColor="#2fff00"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/f_usbarsenal_tv_mount_state"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="No image is mounted."
                            android:textColor="#e0e0e0"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/f_usbarsenal_imgbtn_reloadMountStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="false"
                        android:backgroundTint="#2fff00"
                        android:baselineAlignBottom="false"
                        android:contentDescription="Reload"
                        android:cropToPadding="false"
                        android:src="@android:drawable/ic_menu_rotate"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_ll_mounted_state"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.15" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Inquiry string:"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="(empty to reset)"
                        android:textColor="#8FBC8F" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/f_usbarsenal_et_inquiryString"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="none"
                            android:ems="10"
                            android:inputType="text"
                            android:textColor="#e0e0e0"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/f_usbarsenal_btn_changeInquiryString"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#1a1a1a"
                            android:text="Change"
                            android:textColor="#2fff00" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Current inquiry string:"
                    android:textColor="#2fff00"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/f_usbarsenal_tv_current_inquiry_string"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Linux File-CD/Stor gadget (kernel default)"
                    android:textColor="#e0e0e0" />
            </LinearLayout>
        </LinearLayout>

        <!-- ─── USB NETWORK TETHERING ─── -->

        <LinearLayout
            android:id="@+id/f_usbarsenal_ll_usbnetworktethering"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/f_usbarsenal_ll_usbnetworktethering_sub1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#1a1a1a"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="USB NETWORK TETHERING"
                    android:textColor="#2fff00"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/f_usbarsenal_ll_tv_usbnetworktethering_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:text="Share internet connection via USB or set up a USB-to-Ethernet adapter."
                android:textColor="#8FBC8F"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/f_usbarsenal_ll_usbnetworktethering_sub2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Attack Mode + Spinner -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/f_usbarsenal_tv_attackmode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:text="Attack Mode:"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_spr_networkattackmode"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.4" />

                    <Spinner
                        android:id="@+id/f_usbarsenal_spr_networkattackmode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:entries="@array/usbarsenal_usb_network_attack_mode"
                        android:layout_weight="0.6"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_tv_attackmode"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Upstream Interface -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/f_usbarsenal_tv_upstream"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Upstream Interface (e.g. wlan0):"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_et_usbnetwork_upstreamiface"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.5" />

                    <EditText
                        android:id="@+id/f_usbarsenal_et_usbnetwork_upstreamiface"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_tv_upstream"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- USB network interface -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/f_usbarsenal_tv_usbnetiface"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="USB network interface (e.g. rndis0):"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_et_usbnetwork_usbfunc"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.5" />

                    <EditText
                        android:id="@+id/f_usbarsenal_et_usbnetwork_usbfunc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_tv_usbnetiface"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- IP address for target -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/f_usbarsenal_tv_targetip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="IP address for target:"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_et_usbnetwork_targetip"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.5" />

                    <EditText
                        android:id="@+id/f_usbarsenal_et_usbnetwork_targetip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_tv_targetip"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Your USB Network IP -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/f_usbarsenal_tv_gatewayip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Your USB Network IP:"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_et_usbnetwork_gatewayip"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.5" />

                    <EditText
                        android:id="@+id/f_usbarsenal_et_usbnetwork_gatewayip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_tv_gatewayip"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- IP Subnet Mask -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/f_usbarsenal_tv_subnetmask"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="IP Subnet Mask (octet format):"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/f_usbarsenal_et_usbnetwork_ipsubnetmask"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.5" />

                    <EditText
                        android:id="@+id/f_usbarsenal_et_usbnetwork_ipsubnetmask"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:autofillHints="none"
                        android:textColor="#e0e0e0"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/f_usbarsenal_tv_subnetmask"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <Button
                    android:id="@+id/f_usbarsenal_btn_runusbnetworktethering"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#2fff00"
                    android:text="RUN IN NETHUNTER TERMINAL"
                    android:textColor="#000000" />

                <Button
                    android:id="@+id/f_usbarsenal_btn_saveusbnetworktethering"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#1a1a1a"
                    android:text="SAVE CONFIG TO DATABASE"
                    android:textColor="#2fff00" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
